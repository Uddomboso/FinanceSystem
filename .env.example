# PennyWise v2.0 Environment Configuration Template
# 
# Instructions:
# 1. Copy this file to .env in the root directory: cp .env.example .env
# 2. Fill in your actual API keys and credentials
# 3. NEVER commit the .env file to version control!
#
# The application will run in DEMO MODE if these are not set or left as "demo_*" values.

# ============================================
# AI Configuration (GROQ API)
# ============================================
# Get your GROQ API key from: https://console.groq.com/
# Leave as "demo_mode" to run without AI features
GROQ_API_KEY=demo_mode

# ============================================
# Plaid API Configuration (Bank Integration)
# ============================================
# Get your Plaid credentials from: https://dashboard.plaid.com/
# Leave as "demo_*" to run without bank integration
PLAID_CLIENT_ID=demo_plaid_id
PLAID_SECRET=demo_plaid_secret

# Plaid Environment
# Options: https://sandbox.plaid.com (testing) or https://production.plaid.com (live)
PLAID_BASE_URL=https://sandbox.plaid.com

# ============================================
# Demo Mode Notes
# ============================================
# The application automatically runs in DEMO MODE when:
# - GROQ_API_KEY is "demo_mode" or not set, AND
# - PLAID_CLIENT_ID is "demo_plaid_id" or PLAID_SECRET is "demo_plaid_secret"
#
# Demo mode features:
# - Mock financial data for testing
# - Simulated AI responses
# - All features available except real bank connections
# - Perfect for development and testing without API keys
