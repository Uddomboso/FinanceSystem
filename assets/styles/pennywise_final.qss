/* assets/styles/pennywise_clean.qss - UPDATED */
/* PennyWise Final Theme - No Unsupported Properties */

/* ===== MAIN WINDOW ===== */
QMainWindow {
    background: #F9FAFB;
    font-family: 'Segoe UI', system-ui, sans-serif;
    color: #1F2937;
}

/* ===== CARDS ===== */
QFrame.card {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 16px;
    padding: 20px;
}

QFrame.card:hover {
    border-color: #2563EB;
    background: #FFFFFF;
}

/* ===== PENNY'S SPECIAL ELEMENTS ===== */
QFrame#penny_bubble {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #FEF3C7, stop:1 #FDE68A);
    border-left: 4px solid #F59E0B;
    border-radius: 12px;
    padding: 16px;
    margin: 8px;
}

/* ===== BUTTONS ===== */
QPushButton.primary {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2563EB, stop:1 #1D4ED8);
    color: white;
    border: none;
    border-radius: 12px;
    padding: 12px 24px;
    font-weight: 600;
    font-size: 14px;
}

QPushButton.primary:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1D4ED8, stop:1 #1E40AF);
}

QPushButton.secondary {
    background: transparent;
    color: #2563EB;
    border: 2px solid #2563EB;
    border-radius: 12px;
    padding: 10px 22px;
    font-weight: 600;
    font-size: 14px;
}

QPushButton.secondary:hover {
    background: rgba(37, 99, 235, 0.1);
}

/* ===== METRIC CHIPS ===== */
QFrame.metric-chip {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 16px;
    padding: 16px;
}

QLabel.metric-value {
    font-size: 24px;
    font-weight: bold;
    color: #1F2937;
}

QLabel.metric-label {
    font-size: 12px;
    color: #6B7280;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* ===== PROGRESS BARS ===== */
QProgressBar {
    border: none;
    background: #E5E7EB;
    border-radius: 10px;
    text-align: center;
    color: #1F2937;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #10B981, stop:1 #34D399);
    border-radius: 10px;
}

/* ===== INPUT FIELDS ===== */
QLineEdit, QTextEdit, QComboBox {
    background: #FFFFFF;
    border: 2px solid #E5E7EB;
    border-radius: 12px;
    padding: 12px 16px;
    font-size: 14px;
    selection-background-color: #2563EB;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus {
    border-color: #2563EB;
    background: #FFFFFF;
}

/* ===== NAVIGATION ===== */
QPushButton.nav-item {
    background: transparent;
    color: #6B7280;
    border: none;
    border-radius: 12px;
    padding: 12px 16px;
    text-align: left;
    font-size: 14px;
}

QPushButton.nav-item:hover {
    background: rgba(37, 99, 235, 0.08);
    color: #2563EB;
}

/* ===== SCROLLBARS ===== */
QScrollBar:vertical {
    background: #F3F4F6;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #D1D5DB;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #9CA3AF;
}

/* ===== ANIMATION-FRIENDLY STYLES ===== */
/* Note: QSS doesn't support CSS transitions/transforms */
/* These are handled programmatically in Python */